{
  "name": "kick-soundboard-local",
  "version": "0.3.2",
  "description": "Local Kick channel reward soundboard for Windows streamers",
  "author": "itsmehdi7",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win:installer": "electron-builder --win nsis --x64 --publish never",
    "build:win:portable": "electron-builder --win portable --x64 --publish never",
    "build:win:zip": "electron-builder --win zip --x64 --publish never",
    "build:win:all": "electron-builder --win nsis portable zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.localvc.kicksoundboard",
    "productName": "Kick Soundboard",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "protocols": [
      {
        "name": "Kick Soundboard Protocol",
        "schemes": [
          "kick-soundboard"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "build/icon.svg",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Kick-Soundboard-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Kick-Soundboard-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "packageManager": "pnpm@9.15.4"
}
